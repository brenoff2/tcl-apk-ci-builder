<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only local-network app inventory and a user-visible foreground service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for user-confirmed in-app APK updates. No silent installs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- No discovery or scanning: only headphones already paired with the TV. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <queries>
        <!-- Explicit visibility for the official Disney+ deep-link handler. -->
        <package android:name="com.disney.disneyplus" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/tcl_icon"
        android:banner="@drawable/tcl_banner"
        android:label="AnyTV Connect"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="tcl.shared.TclInstallResultReceiver"
            android:exported="false" />
        <service
            android:name=".TclCatalogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled LAN inventory of Android TV installed apps for pairing with a phone remote" />
        </service>
    </application>
</manifest>
